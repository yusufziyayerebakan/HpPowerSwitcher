<Window x:Class="HpPowerSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ctl="clr-namespace:HpPowerSwitcher.Controls"
        Title="HP Spectre Power &amp; Service Control"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1060" Height="790"
        MinWidth="860" MinHeight="630"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <!-- Windows 11 Task Manager Style Seamless Window Chrome -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Standard Button Style -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Background" Value="#3B1822"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F1D1D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivateBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Background" Value="#132F26"/>
            <Setter Property="BorderBrush" Value="#14532D"/>
            <Setter Property="Foreground" Value="#86EFAC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#166534"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Continuous Spin Animation for Loading Indicators -->
        <Style x:Key="SpinningTextStyle" TargetType="TextBlock">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="SpinStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.85"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Windows 11 Fluent Caption Buttons (Minimize, Maximize) -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Fluent Caption Close Button (Red Hover) -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B8101C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Hamburger Toggle Button Style -->
        <Style x:Key="SidebarNavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#172238"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Task Manager Navigation Rail RadioButton Style -->
        <Style x:Key="SidebarNavRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Vertical Active Indicator Pill -->
                                <Border x:Name="activeIndicator" Grid.Column="0" Width="3" Height="18"
                                        Background="#38BDF8" CornerRadius="1.5"
                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                        Visibility="Collapsed"/>

                                <!-- Centered Icon in 54px Rail -->
                                <TextBlock x:Name="iconBlock" Grid.Column="1"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- Text Label Content in Column 2 -->
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#172238"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented option button (refresh rate / history window) -->
        <Style x:Key="SegBtnStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="5" Padding="10,4" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#172238"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#7DD3FC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#0B1120">
        <Grid.RowDefinitions>
            <!-- Row 0: Windows 11 Task Manager Style Dark Header (Height 38) -->
            <RowDefinition Height="38"/>
            <!-- Row 1: Sidebar + Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TASK MANAGER STYLE APPLICATION HEADER -->
        <Border Grid.Row="0" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Application Brand & Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="HP Spectre Power &amp; Service Control" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Custom Fluent Caption Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="BtnTitleMinimize" Style="{StaticResource CaptionBtnStyle}" Content="—" FontSize="11" Click="BtnTitleMinimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="BtnTitleMaximize" Style="{StaticResource CaptionBtnStyle}" Content="🗖" FontSize="11" Click="BtnTitleMaximize_Click" ToolTip="Maximize"/>
                    <Button x:Name="BtnTitleClose" Style="{StaticResource CaptionCloseBtnStyle}" Content="✕" FontSize="11" Click="BtnTitleClose_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN BODY: COLLAPSIBLE SIDEBAR + CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Collapsible Navigation Rail (210px expanded / 54px collapsed) -->
                <ColumnDefinition x:Name="ColSidebar" Width="210"/>
                <!-- Column 1: Main Content Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION BAR -->
            <Border Grid.Column="0" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="0,0,1,0" ClipToBounds="True">
                <DockPanel LastChildFill="True">
                    <!-- Top: Hamburger Toggle Button -->
                    <Border DockPanel.Dock="Top" Margin="0,6,0,4">
                        <StackPanel>
                            <Button x:Name="BtnToggleSidebar" Style="{StaticResource SidebarNavBtnStyle}" Click="BtnToggleSidebar_Click" ToolTip="Collapse navigation">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="☰" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtToggleLabel" Grid.Column="1" Text="Navigation" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#1E293B" Margin="10,4,10,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items -->
                    <StackPanel Margin="0,2,0,0">
                        <!-- Tab 1: Profiles & Power Modes -->
                        <RadioButton x:Name="RadioNavProfiles" GroupName="NavTabs" Style="{StaticResource SidebarNavRadioStyle}"
                                     Tag="⚡" IsChecked="True" Checked="NavRadio_Checked">
                            <StackPanel x:Name="PanelNavProfiles" VerticalAlignment="Center">
                                <TextBlock Text="Profiles &amp; Power" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Tab 2: HP Services & Watchdogs -->
                        <RadioButton x:Name="RadioNavServices" GroupName="NavTabs" Style="{StaticResource SidebarNavRadioStyle}"
                                     Tag="🛡️" Checked="NavRadio_Checked">
                            <StackPanel x:Name="PanelNavServices" VerticalAlignment="Center">
                                <TextBlock Text="HP Services" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Tab 3: Hardware & Thermal Monitor -->
                        <RadioButton x:Name="RadioNavSensors" GroupName="NavTabs" Style="{StaticResource SidebarNavRadioStyle}"
                                     Tag="📊" Checked="NavRadio_Checked">
                            <StackPanel x:Name="PanelNavSensors" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sensors &amp; Heat" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1" Margin="16,10,16,10">
                <Grid.RowDefinitions>
                    <!-- Top Header & Live Hardware Indicators -->
                    <RowDefinition Height="Auto"/>
                    <!-- Active Tab Content -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP HEADER & LIVE HARDWARE INDICATORS -->
                <Border Grid.Row="0" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtModelName" Text="HP Spectre x360" FontSize="16.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Border x:Name="BadgeAdmin" Background="#14532D" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAdminBadge" Text="ADMIN • BIOS WMI READY" FontSize="10" FontWeight="Bold" Foreground="#86EFAC"/>
                                </Border>
                                <Button x:Name="BtnElevate" Content="Restart as Admin" Style="{StaticResource ActionBtnStyle}" Margin="10,0,0,0" Padding="8,2" Visibility="Collapsed" Click="BtnElevate_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtBiosInfo" Text="BIOS: Loading..." FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Live Hardware & Memory Indicators -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE BIOS THERMAL" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtActiveThermalIndicator" Text="Detecting..." FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="POWER &amp; BATTERY" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtBatteryIndicator" Text="--%" FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                <StackPanel>
                                    <TextBlock Text="HP BACKGROUND RAM" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtHpRamIndicator" Text="-- MB" FontSize="13" FontWeight="Bold" Foreground="#FB923C" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TABBED CONTENT PAGES (Controlled by Sidebar) -->
                <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- TAB 1: PROFILES & WINDOWS POWER MODES -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,2,0,10">
                                <!-- HP BIOS THERMAL & FAN PROFILE CARDS -->
                                <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="HP BIOS Thermal &amp; Fan Profile" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock Text="  (Direct root\wmi:hpqBIntM • &lt; 5ms instant switch)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkSyncWinOverlay" Grid.Column="1" IsChecked="True" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"
                                                      Content="Also sync Windows 11 Power Mode"/>
                                        </Grid>

                                        <UniformGrid x:Name="GridThermalCards" Columns="3" Rows="2" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>

                                <!-- WINDOWS 11 POWER OVERLAY BAR -->
                                <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Windows 11 Power Mode" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <TextBlock x:Name="TxtWinOverlaySub" Text="powrprof.dll overlay scheme" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnWinEco" Content="🍃 Best Power Efficiency" Style="{StaticResource ActionBtnStyle}" Margin="0,0,8,0" Click="BtnWinEco_Click"/>
                                            <Button x:Name="BtnWinBalanced" Content="⚖ Balanced" Style="{StaticResource ActionBtnStyle}" Margin="0,0,8,0" Click="BtnWinBalanced_Click"/>
                                            <Button x:Name="BtnWinPerf" Content="🚀 Best Performance" Style="{StaticResource ActionBtnStyle}" Click="BtnWinPerf_Click"/>
                                        </StackPanel>

                                        <CheckBox x:Name="ChkApplyBothAcDc" Grid.Column="2" Content="Apply to both AC &amp; Battery" IsChecked="True" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- ARCHITECTURE & QUICK INFO -->
                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Direct Hardware Thermal Regulation" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            <TextBlock Text="Thermal profiles communicate directly with the HP BIOS Embedded Controller (EC) via ACPI/WMI without needing the HP Command Center bloatware or background services running. Windows Power Modes dynamically tune CPU frequency scaling and energy performance preference (EPP)." 
                                                       FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: HP SERVICES, TELEMETRY & BACKGROUND BLOAT -->
                    <TabItem>
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="HP Services, Auto-Launch Watchdogs &amp; Telemetry" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtServiceSummary" Text="" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                    <!-- Live Loading Pill Badge -->
                                    <Border x:Name="BadgeRefreshing" Background="#0F2942" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↻" Style="{StaticResource SpinningTextStyle}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRefreshBadge" Text="Refreshing..." FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnDisableAllBloat" Content="🧹 Stop &amp; Disable All Bloat + Watchdogs" Style="{StaticResource DangerBtnStyle}" Margin="0,0,8,0" Click="BtnDisableAllBloat_Click"/>
                                    <Button x:Name="BtnRefresh" Content="↻ Refresh" Style="{StaticResource ActionBtnStyle}" Click="BtnRefresh_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Sleek Indeterminate Loading Bar -->
                                    <ProgressBar x:Name="BarLoading" Grid.Row="0" Height="2.5" IsIndeterminate="True"
                                                 Background="Transparent" Foreground="#38BDF8" BorderThickness="0"
                                                 Margin="4,0,4,4" Visibility="Collapsed"/>

