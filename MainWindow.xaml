<Window x:Class="HpPowerSwitcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HP Power Switcher">
    <Grid x:Name="RootGrid" RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#101D2B" Offset="0" />
                <GradientStop Color="#0C141F" Offset="0.55" />
                <GradientStop Color="#101B26" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent" Padding="20,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{StaticResource MintBrush}" />
                <TextBlock Text="HP Power Switcher" FontSize="12" Foreground="#A8BDCD" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        OpenPaneLength="204" PaneDisplayMode="Auto" IsPaneOpen="True" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0B131E" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B131E" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#86E8CB" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#86E8CB" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#193137" />
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel Margin="20,8,12,28" Spacing="14">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#86E8CB" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE945;" FontSize="22" Foreground="#10282B" />
                    </Border>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Power Switcher" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="YOUR DEVICE. YOUR RULES." FontSize="8" CharacterSpacing="100" Foreground="#8298AB" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Power profiles" Tag="Profiles">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="HP services" Tag="Services">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Live sensors" Tag="Sensors">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Border Margin="16,20" Padding="12" CornerRadius="12" Background="#101F2C" BorderBrush="#243747" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="5" Height="5" Fill="#86E8CB" VerticalAlignment="Center" />
                            <TextBlock Text="ON-DEVICE CONTROL" FontSize="8" CharacterSpacing="90" Foreground="#A8BDCD" />
                        </StackPanel>
                        <TextBlock Text="Built for your HP." FontSize="11" Foreground="#71899E" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>
            <Grid Padding="28,20,28,16" RowSpacing="22" MaxWidth="1360" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock x:Name="TxtPageEyebrow" Text="DEVICE CONTROL / POWER" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource MintBrush}" />
                        <TextBlock x:Name="TxtPageTitle" Text="Power &amp; performance" FontSize="30" FontWeight="SemiBold" CharacterSpacing="-25" />
                        <TextBlock x:Name="TxtPageDescription" Text="Find your balance. Make every charge count." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{StaticResource QuietButtonStyle}" ToolTipService.ToolTip="Device details" AutomationProperties.Name="Device details">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" MaxWidth="380">
                                        <TextBlock Text="YOUR DEVICE" Style="{StaticResource EyebrowStyle}" />
                                        <TextBlock x:Name="TxtModelName" Text="Reading hardware…" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtBiosInfo" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="BtnRefresh" Style="{StaticResource QuietButtonStyle}" Click="BtnRefresh_Click" AutomationProperties.Name="Refresh">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12"/><TextBlock Text="Refresh" FontSize="12" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SurfaceStyle}" Padding="16,14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="POWER SOURCE" Style="{StaticResource EyebrowStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE83E;" FontSize="14" Foreground="#86E8CB"/><TextBlock x:Name="TxtBatteryIndicator" Text="Reading battery…" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SurfaceStyle}" Padding="16,14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource EyebrowStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9CA;" FontSize="14" Foreground="#A8B6FF"/><TextBlock x:Name="TxtActiveThermalIndicator" Text="Reading profile…" FontSize="12" /></StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SurfaceStyle}" Padding="16,14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="SYSTEM ACCESS" Style="{StaticResource EyebrowStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="#97B6CE"/><TextBlock x:Name="TxtAdminBadge" Text="Checking access…" FontSize="12" /></StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="ProfilesView" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,0,4,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4"><TextBlock Text="Choose your profile" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Six ways to make your laptop feel right." FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                            <CheckBox x:Name="ChkSyncWinOverlay" Grid.Column="1" Content="Sync Windows mode" FontSize="11" IsChecked="True" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="GridThermalCards" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        </Grid>
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,4,0,0">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4"><TextBlock Text="Windows power mode" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TxtWinOverlaySub" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                    <CheckBox x:Name="ChkApplyBothAcDc" Grid.Column="1" Content="AC + battery" IsChecked="True" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="BtnWinEco" Content="Efficiency" Tag="BestPowerEfficiency" Click="Overlay_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <Button x:Name="BtnWinBalanced" Grid.Column="1" Content="Balanced" Tag="Balanced" Click="Overlay_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <Button x:Name="BtnWinPerf" Grid.Column="2" Content="Performance" Tag="BestPerformance" Click="Overlay_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="ServicesView" Grid.Row="2" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource SurfaceStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6"><TextBlock x:Name="TxtServiceSummary" Text="Reading background activity…" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Manage HP telemetry, services, and auto-launchers." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            <Button x:Name="BtnDisableAllBloat" Grid.Column="1" Content="Stop telemetry &amp; bloat" Style="{StaticResource QuietButtonStyle}" Click="BtnDisableAllBloat_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListView x:Name="ListComponents" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceStyle}" HorizontalAlignment="Stretch">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding CategoryBadge}" Foreground="{Binding CategoryBrush}" FontSize="10" />
                                            <TextBlock Text="{Binding StatusDisplay}" TextWrapping="Wrap" FontSize="11" Foreground="#B0C6D7" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="{Binding ActivateText}" IsEnabled="{Binding CanActivate}" Tag="{Binding}" Click="ActivateItem_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" FontSize="11" />
                                            <Button Content="{Binding DeactivateText}" IsEnabled="{Binding CanDeactivate}" Tag="{Binding}" Click="DeactivateItem_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ContentControl x:Name="SensorHost" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </NavigationView>
        <ProgressBar x:Name="BarLoading" Grid.Row="2" IsIndeterminate="False" Visibility="Collapsed" Height="2" Foreground="{StaticResource MintBrush}" />
        <Border Grid.Row="3" BorderBrush="#21303D" BorderThickness="0,1,0,0" Background="#0B141F" Padding="20,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="#86E8CB" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtStatusBar" Text="Ready." MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#839BAE" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" Content="Close to tray" FontSize="11" Foreground="#93AABC" MinHeight="24" />
            </Grid>
        </Border>
    </Grid>
</Window>
