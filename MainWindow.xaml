                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Status & Memory Metrics -->
