                                                                    <TextBlock Text="{Binding MemoryDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                                                </Border>
                                                                <Border Background="#172033" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
