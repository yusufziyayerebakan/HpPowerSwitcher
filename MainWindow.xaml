<Window x:Class="HpPowerSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP Spectre Power &amp; Service Control"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="980" Height="780"
        MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Background" Value="#3B1822"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F1D1D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivateBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Background" Value="#132F26"/>
            <Setter Property="BorderBrush" Value="#14532D"/>
            <Setter Property="Foreground" Value="#86EFAC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#166534"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & LIVE INDICATORS -->
        <Border Grid.Row="0" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtModelName" Text="HP Spectre x360" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border x:Name="BadgeAdmin" Background="#14532D" CornerRadius="5" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAdminBadge" Text="ADMIN • BIOS WMI READY" FontSize="10.5" FontWeight="Bold" Foreground="#86EFAC"/>
                        </Border>
                        <Button x:Name="BtnElevate" Content="Restart as Admin" Style="{StaticResource ActionBtnStyle}" Margin="10,0,0,0" Padding="8,3" Visibility="Collapsed" Click="BtnElevate_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtBiosInfo" Text="BIOS: Loading..." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Live Hardware & Memory Indicators -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE BIOS THERMAL" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtActiveThermalIndicator" Text="Detecting..." FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="POWER &amp; BATTERY" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtBatteryIndicator" Text="--%" FontSize="13.5" FontWeight="Bold" Foreground="#34D399" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel>
                            <TextBlock Text="HP BACKGROUND RAM" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtHpRamIndicator" Text="-- MB" FontSize="13.5" FontWeight="Bold" Foreground="#FB923C" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. HP BIOS THERMAL & FAN PROFILE CARDS -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Grid Margin="2,0,2,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HP BIOS Thermal &amp; Fan Profile" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="  (Direct root\wmi:hpqBIntM • &lt; 5ms instant switch)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="ChkSyncWinOverlay" Grid.Column="1" IsChecked="True" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"
                          Content="Also sync Windows 11 Power Mode"/>
            </Grid>

            <UniformGrid x:Name="GridThermalCards" Columns="3" Rows="2" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- 3. WINDOWS 11 POWER OVERLAY BAR -->
        <Border Grid.Row="2" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Windows 11 Power Mode" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtWinOverlaySub" Text="powrprof.dll overlay scheme" FontSize="11.5" Foreground="#94A3B8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnWinEco" Content="🍃 Best Power Efficiency" Style="{StaticResource ActionBtnStyle}" Margin="0,0,8,0" Click="BtnWinEco_Click"/>
                    <Button x:Name="BtnWinBalanced" Content="⚖ Balanced" Style="{StaticResource ActionBtnStyle}" Margin="0,0,8,0" Click="BtnWinBalanced_Click"/>
                    <Button x:Name="BtnWinPerf" Content="🚀 Best Performance" Style="{StaticResource ActionBtnStyle}" Click="BtnWinPerf_Click"/>
                </StackPanel>

                <CheckBox x:Name="ChkApplyBothAcDc" Grid.Column="2" Content="Apply to both AC &amp; Battery" IsChecked="True" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 4. HP SERVICES, TELEMETRY & BACKGROUND BLOAT MANAGER -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HP Services, Telemetry &amp; Background Processes" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtServiceSummary" Text="" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnDisableAllBloat" Content="🧹 Stop &amp; Disable All Telemetry / Bloat" Style="{StaticResource DangerBtnStyle}" Margin="0,0,8,0" Click="BtnDisableAllBloat_Click"/>
                    <Button x:Name="BtnRefresh" Content="↻ Refresh" Style="{StaticResource ActionBtnStyle}" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListComponents">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="4,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Live Status Indicator Dot -->
                                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="2,0,12,0"
                                                 Fill="{Binding StatusDotBrush}" ToolTip="{Binding StateText}"/>

                                        <!-- Name, Category Badge & Description -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding CategoryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Status & Memory Metrics -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Background="#172033" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MemoryDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            </Border>
                                            <Border Background="#172033" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StartModeText}" FontSize="11" Foreground="#94A3B8"/>
                                            </Border>
                                            <Border Background="{Binding StateBadgeBg}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center" MinWidth="72">
                                                <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StateBadgeFg}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Activate / Stop & Disable Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Activate" Tag="{Binding Model}" Style="{StaticResource ActivateBtnStyle}"
                                                    IsEnabled="{Binding CanActivate}" Padding="10,5" Margin="0,0,6,0" Click="BtnActivateItem_Click"/>
                                            <Button Content="Stop &amp; Disable" Tag="{Binding Model}" Style="{StaticResource DangerBtnStyle}"
                                                    IsEnabled="{Binding CanDeactivate}" Padding="10,5" Click="BtnDeactivateItem_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 5. BOTTOM STATUS BAR -->
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatusBar" Text="Ready." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" Content="Minimize to System Tray on close" IsChecked="False" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
