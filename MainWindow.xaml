                                                        <TextBlock Text="Physical Disk Activity &amp; Transfer Rates" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Read: " FontSize="11.5" Foreground="#64748B"/>
                                                        <TextBlock x:Name="TxtDiskDetailRead" Text="-- MB/s" FontSize="11.5" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,14,0"/>
                                                        <TextBlock Text="Write: " FontSize="11.5" Foreground="#64748B"/>
                                                        <TextBlock x:Name="TxtDiskDetailWrite" Text="-- MB/s" FontSize="11.5" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="TxtDiskDetailActive" Text="--" FontSize="28" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="ACTIVE TIME" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                            <ctl:LiveChart x:Name="ChartDiskDetail" Height="240" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 5. WI-FI VIEW -->
                                <StackPanel x:Name="ViewSensorWifi" Visibility="Collapsed">
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📶" FontSize="16" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="TxtWifiDetailName" Text="Wi-Fi Network Adapter" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Link: " FontSize="11.5" Foreground="#64748B"/>
                                                        <TextBlock x:Name="TxtWifiDetailLink" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,14,0"/>
                                                        <TextBlock Text="Download: " FontSize="11.5" Foreground="#64748B"/>
                                                        <TextBlock x:Name="TxtWifiDetailDownload" Text="-- MB/s" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,14,0"/>
                                                        <TextBlock Text="Upload: " FontSize="11.5" Foreground="#64748B"/>
                                                        <TextBlock x:Name="TxtWifiDetailUpload" Text="-- MB/s" FontSize="11.5" FontWeight="SemiBold" Foreground="#C084FC"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <ctl:LiveChart x:Name="ChartWifiDetail" Height="240" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 6. NPU VIEW -->
                                <StackPanel x:Name="ViewSensorNpu" Visibility="Collapsed">
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🤖" FontSize="16" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="TxtNpuDetailName" Text="Neural Processing Unit (NPU)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="AI ACCELERATOR" FontSize="10" FontWeight="SemiBold" Foreground="#A855F7"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Dedicated low-power hardware neural engine for local AI models, DirectML, and Windows Copilot Runtime" FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtNpuDetailLoad" Grid.Column="1" Text="--" FontSize="28" FontWeight="Bold" Foreground="#A855F7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ctl:LiveChart x:Name="ChartNpuDetail" Height="240" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 7. COOLING & POWER VIEW -->
                                <StackPanel x:Name="ViewSensorCooling" Visibility="Collapsed">
                                    <UniformGrid Columns="2" Margin="-4,0,-4,4">
                                        <!-- Fans -->
                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10,14,12" Margin="4">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🌀" FontSize="14" Margin="0,0,8,0"/>
                                                        <TextBlock Text="COOLING FANS" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtFanDetailSub" FontSize="10.5" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtFanDetail" Text="--" FontSize="22" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ctl:LiveChart x:Name="ChartFanDetail" Height="180" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Battery -->
                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10,14,12" Margin="4">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔋" FontSize="14" Margin="0,0,8,0"/>
                                                        <TextBlock Text="BATTERY POWER" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtBattDetailSub" FontSize="10.5" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtBattDetail" Text="--" FontSize="22" FontWeight="Bold" Foreground="#FACC15" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ctl:LiveChart x:Name="ChartBattDetail" Height="180" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                                <TextBlock Text="Sampling only runs while this page is visible. Lower refresh rates and shorter history use less CPU; hover a graph for exact values." FontSize="11" Foreground="#64748B" Margin="2,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- BOTTOM STATUS BAR -->
                <Grid Grid.Row="2" Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatusBar" Text="Ready." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" Content="Minimize to System Tray on close" IsChecked="False" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
